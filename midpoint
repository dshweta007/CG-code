#include <iostream>
#include <GL/glut.h>
using namespace std;
int x1, y1, r;
void plot(int x, int y)
{
glBegin(GL_POINTS);
glVertex2i(x+x1, y+y1);
glEnd();
}
void myInit ()
{
glClearColor(1.0, 1.0, 1.0, 0.0);
gluOrtho2D(0.0, 640.0, 0.0, 480.0);
}
void midcircle()
{
int x = 0;
int y = r;
float d = 1.25 - r;
plot(x, y);
while (y > x)
{
if (d < 0)
{
}
